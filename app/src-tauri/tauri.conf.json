{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tormin",
  "version": "1.0.0",
  "identifier": "ua.tormin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Tormin",
    "shortDescription": "Minimalist BitTorrent client",
    "category": "Utility",
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "mimeType": "application/x-bittorrent",
        "description": "Torrent file",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
